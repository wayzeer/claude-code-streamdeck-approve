{
	"name": "claude-code-streamdeck-approve",
	"version": "1.0.0",
	"description": "Approve or deny Claude Code permission prompts from an Elgato Stream Deck.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.wayzeer.claude-approve\"",
		"install-hook": "node hook/install.mjs",
		"uninstall-hook": "node hook/install.mjs --uninstall",
		"validate": "streamdeck validate com.wayzeer.claude-approve.sdPlugin",
		"pack": "npm run build && streamdeck pack com.wayzeer.claude-approve.sdPlugin --output dist --force",
		"test": "node test/simulate.mjs"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.3",
		"@rollup/plugin-commonjs": "^29.0.2",
		"@rollup/plugin-node-resolve": "^15.2.2",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.1.0",
		"@tsconfig/node20": "^20.1.2",
		"@types/node": "~24.1.0",
		"rollup": "^4.0.2",
		"tslib": "^2.6.2",
		"typescript": "^5.2.2",
		"ws": "^8.18.0"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.3"
	}
}
